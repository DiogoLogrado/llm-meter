{
  "name": "llm-meter",
  "displayName": "LLM Meter",
  "description": "Status bar meter for Ollama Cloud usage limits. Local install only, no telemetry, no auto-update.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiogoLogrado/llm-meter"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=18"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/ui.js",
  "contributes": {
    "commands": [
      { "command": "llmMeter.setApiKey", "title": "Set API Key", "category": "LLM Meter" },
      { "command": "llmMeter.setThresholds", "title": "Set Threshold Percentages", "category": "LLM Meter" },
      { "command": "llmMeter.setInterval", "title": "Set Refresh Interval", "category": "LLM Meter" }
    ]
  },
  "scripts": {
    "package": "npm run package:ollama",
    "package:ollama": "node scripts/preflight.js && npx --yes @vscode/vsce@2 package --out dist/llm-meter-ollama.vsix --allow-missing-repository --no-rewrite-relative-links"
  }
}
