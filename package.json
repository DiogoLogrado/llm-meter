{
  "name": "ollama-cloud-meter",
  "displayName": "Ollama Cloud Meter",
  "description": "Unofficial status bar meter for Ollama Cloud session and weekly usage limits. One request, no telemetry, readable source.",
  "version": "0.2.1",
  "publisher": "DiogoLogrado",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiogoLogrado/ollama-cloud-meter"
  },
  "bugs": {
    "url": "https://github.com/DiogoLogrado/ollama-cloud-meter/issues"
  },
  "homepage": "https://github.com/DiogoLogrado/ollama-cloud-meter#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ollama",
    "ollama cloud",
    "usage",
    "quota",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=18"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/ui.js",
  "contributes": {
    "commands": [
      { "command": "ollamaCloudMeter.setApiKey", "title": "Set API Key", "category": "Ollama Cloud Meter" },
      { "command": "ollamaCloudMeter.setThresholds", "title": "Set Threshold Percentages", "category": "Ollama Cloud Meter" },
      { "command": "ollamaCloudMeter.setInterval", "title": "Set Refresh Interval", "category": "Ollama Cloud Meter" }
    ]
  },
  "scripts": {
    "package": "node scripts/preflight.js && npx --yes @vscode/vsce@2 package --out dist/ollama-cloud-meter.vsix"
  }
}
